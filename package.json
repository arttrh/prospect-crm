{
  "name": "prospect-crm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/build-diego.mjs && next build",
    "build:template": "node scripts/build-diego.mjs",
    "test:template": "node --import ./vendor/diego-astro/node_modules/tsx/dist/loader.mjs --test tests/template-engine.test.ts",
    "start": "next start",
    "lint": "eslint",
    "test": "npm run test:agent-brief && npm run test:auth && playwright test",
    "test:agent-brief": "node --test tests/agent-brief.test.mjs",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.mjs",
    "test:login": "node --test tests/login.test.mjs",
    "test:leads": "node --test tests/leads.test.mjs",
    "test:backend": "node --test tests/next-test-server.test.mjs && npm run test:auth && npm run test:login && npm run test:leads"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-tabs": "1.1.21",
    "@radix-ui/themes": "3.3.0",
    "lucide-react": "1.52.0",
    "next": "16.3.8",
    "oracledb": "7.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "20.19.43",
    "@types/oracledb": "7.0.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "typescript": "5.9.3"
  }
}
